# Multi-stage build for the Kodiak dashboard API (Go).
# Replaces the Python image in web_api/Dockerfile.

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/webapi ./cmd/webapi

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/webapi /webapi
ENV PORT=8000
EXPOSE 8000
ENTRYPOINT ["/webapi"]
